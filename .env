# .env file for Vite frontend

VITE_SUI_RPC_URL=https://fullnode.testnet.sui.io:443
# The URL for connecting to the Sui blockchain node (testnet).

VITE_SUI_WALLET_ADDRESS=your_wallet_address_here
# Your wallet address for interacting with the blockchain.

VITE_CONTRACT_ADDRESS=your_contract_address_here
# The address of your deployed smart contract.

VITE_MODULE_NAME=your_module_name_here
# The name of the module in your smart contract package.

VITE_PACKAGE_ID=your_package_id_here
# The unique ID of your smart contract package.

VITE_NODE_ENV=development
# The environment mode (development or production).
